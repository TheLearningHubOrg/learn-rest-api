{
  "name": "learn-rest-api",
  "version": "1.0.0",
  "private": true,
  "description": "Starter orders API for the learn-rest-api guide: HTTP semantics, problem details, ETags, keyset pagination and idempotency keys on plain node:http.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "keywords": [
    "rest",
    "api",
    "http",
    "openapi",
    "rfc9110",
    "rfc9457"
  ],
  "author": "Manthan Ankolekar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLearningHubOrg/learn-rest-api.git"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
